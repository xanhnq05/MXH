# ===== Server =====
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database (MongoDB Atlas) =====
MONGODB_URI=your_mongodb_atlas_uri

# ===== JWT =====
ACCESS_TOKEN_SECRET=change_me_in_production_64_chars_min
REFRESH_TOKEN_SECRET=change_me_in_production_64_chars_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ===== Supabase S3 =====
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxx
SUPABASE_BUCKET=GreenX

# ===== Gmail (gửi OTP) =====
GMAIL_USER=your_email@gmail.com
# Chọn 1 trong 2:
# (1) App Password (dễ, 16 ký tự):
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# (2) OAuth2 (phức tạp hơn, an toàn hơn):
# GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxxxx
# GMAIL_REFRESH_TOKEN=xxxxx

# ===== E2EE fallback =====
E2EE_SERVER_KEY=change_me_64_hex_chars_xxxxxxxxxxxxxxxxxxxxx

# ===== Admin allowlist (CSV) =====
# User có email hoặc _id nằm trong danh sách sẽ được phép truy cập /api/admin/*
# Mặc định: nếu cả 2 rỗng thì default deny (không ai là admin).
# Ví dụ:
# ADMIN_EMAILS=admin1@example.com,admin2@example.com
# ADMIN_USER_IDS=65f0a1b2c3d4e5f6a7b8c9d0
ADMIN_EMAILS=
ADMIN_USER_IDS=

# ===== Redis + Queue (optional - neu khong co, app van chay, chi khong co cache/queue) =====
# Local macOS/Linux/WSL2: REDIS_URL=redis://127.0.0.1:6379
# Docker:    REDIS_URL=redis://redis:6379
# Upstash:   REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379
# Neu de trong -> cache va queue se bi graceful skip (null/no-op).
REDIS_URL=

