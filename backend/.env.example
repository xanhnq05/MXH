# ===== Server =====
PORT=5001
NODE_ENV=development
# Production: URL của Vercel FE
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001

# ===== Database =====
# Local: docker-compose
# Production: MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/mxh

# ===== JWT =====
# Tạo bằng: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace_with_random_64_chars
REFRESH_TOKEN_SECRET=replace_with_random_64_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ===== Supabase Storage S3 =====
SUPABASE_BUCKET=GreenX
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PUBLIC_URL=

# ===== Gmail =====
# App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== E2EE =====
# Tạo bằng: openssl rand -hex 32
E2EE_SERVER_KEY=replace_with_random_32_chars

# ===== Admin allowlist (CSV) =====
ADMIN_EMAILS=
ADMIN_USER_IDS=

# ===== Redis =====
# Local: redis://localhost:6379
# Production (Render): dùng internal connectionString từ Redis addon
REDIS_URL=redis://localhost:6379
