# ===== MXH Docker env (copy sang .env, KHÔNG commit .env) =====
# Generate secrets mới bằng: openssl rand -hex 32 (mỗi cái 32 bytes = 64 hex chars)
# Hoặc PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# ===== Backend secrets (BẮT BUỘC) =====
ACCESS_TOKEN_SECRET=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx
REFRESH_TOKEN_SECRET=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx
E2EE_SERVER_KEY=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx

# ===== Supabase (optional, nếu không có thì tạm bỏ upload) =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=GreenX

# ===== Gmail OTP (optional) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== Admin (optional) =====
ADMIN_EMAILS=
ADMIN_USER_IDS=
