# ===== MXH Docker env (copy sang .env, KHONG commit .env) =====
# Generate secrets moi bang: openssl rand -hex 32 (moi cai 32 bytes = 64 hex chars)
# Hoac PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })

# ===== Backend secrets (BAT BUOC) =====
ACCESS_TOKEN_SECRET=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx
REFRESH_TOKEN_SECRET=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx
E2EE_SERVER_KEY=change_me_64_hex_chars_minimum_xxxxxxxxxxxxxxxxxxxxxx

# ===== Frontend URLs =====
# User app (GreenX)
CLIENT_URL=http://localhost:3000
# Admin console (GreenX Admin) - tach rieng subdomain
ADMIN_CLIENT_URL=http://localhost:3001

# ===== Supabase (optional) =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=GreenX

# ===== Gmail OTP (optional) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===== Admin allowlist (optional) =====
ADMIN_EMAILS=
ADMIN_USER_IDS=
